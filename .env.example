# Server-only configuration. Keep real values out of source control.
APP_ORIGIN=http://127.0.0.1:3107
PARAGON_RUNTIME=railway
PARAGON_DATA_DIR=.railway-data
PORT=3107
# Generate at least 32 random bytes for production.
SESSION_SECRET=
DEMO_ENABLED=true
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_MEMBER_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_ADMIN_USER_IDS=
DISCORD_EVENT_CREATOR_ROLE_IDS=
DISCORD_EVENT_CREATOR_USER_IDS=
# Optional verified character mappings: {"DISCORD_USER_ID":"Sheet Character Name"}
DISCORD_CONTRIBUTION_NAMES={}
DISCORD_CLASS_ROLES={"Warrior":["ROLE_ID"],"Ninja":["ROLE_ID"],"Sura":["ROLE_ID"],"Shaman":["ROLE_ID"]}
# Bot: Server Members Intent; View Channel, Send Messages, Embed Links, Read Message History.
DISCORD_BOT_TOKEN=
DISCORD_EVENT_CHANNEL_ID=
# Private sheet ID / archive values stay in server variables.
GUILD_SHEET_ID=
GUILD_BANK_SNAPSHOT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SCHEDULER_SECRET=
SCHEDULER_ENABLED=false

# Operator maintenance mode stops web actions and scheduled jobs before a reset.
PARAGON_MAINTENANCE=false
